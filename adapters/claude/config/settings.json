{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Enterprise AI Platform — Claude adapter settings template (v3.1). Installer injects this via marker replacement. F4 fix: allowlist replaces denylist; fails closed for all unlisted MCP tools.",
  "permissions": {
    "allow": [
      "mcp__gitlab-reader__get_file",
      "mcp__gitlab-reader__get_repository_file",
      "mcp__gitlab-reader__get_commit_diff",
      "mcp__gitlab-reader__get_branch_diffs",
      "mcp__gitlab-reader__get_merge_request_diffs",
      "mcp__gitlab-reader__list_merge_request_changed_files",
      "mcp__gitlab-reader__list_commits",
      "mcp__gitlab-reader__get_merge_request",
      "mcp__gitlab-reader__list_merge_requests",
      "mcp__gitlab-reader__get_issue",
      "mcp__gitlab-reader__list_issues",
      "mcp__gitlab-reader__get_project",
      "mcp__gitlab-reader__list_projects",
      "mcp__gitlab-reader__list_repository_tree",
      "mcp__gitlab-reader__get_tags",
      "mcp__gitlab-reader__get_pipeline",
      "mcp__gitlab-reader__list_pipelines",
      "mcp__redmine-reader__redmine_get_issue",
      "mcp__redmine-reader__redmine_list_issues",
      "mcp__redmine-reader__redmine_get_project",
      "mcp__canary_mongo_db__find",
      "mcp__canary_mongo_db__aggregate",
      "mcp__canary_mongo_db__list-collections",
      "mcp__canary_mongo_db__list-databases",
      "mcp__postgres-reader__query",
      "mcp__postgres-reader__list_tables",
      "mcp__postgres-reader__describe_table",
      "mcp__postgres-reader__list_schemas"
    ],
    "deny": [
      "mcp__*",
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(rm -rf*)",
      "Bash(flyway*)"
    ],
    "ask": [
      "Edit(**/db/migration/**)",
      "Write(**/db/migration/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/hash-check.js",
            "timeout": 5,
            "statusMessage": "Verifying contract integrity..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/audit.js --event PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/audit.js --event Stop",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": false
}
