# Enterprise AI Platform — environment variables template
# Copy to .env (gitignored) and fill in real values.
# NEVER commit .env with real values.

# ─── GitLab MCP ─────────────────────────────────────────────────────────
GITLAB_PAT=<YOUR_GITLAB_READ_ONLY_PAT>
GITLAB_BASE_URL=<YOUR_GITLAB_BASE_URL>
GITLAB_MCP_PATH=<PATH_TO_GITLAB_MCP_SERVER_INDEX_JS_PARENT>

# ─── Redmine MCP (optional) ─────────────────────────────────────────────
REDMINE_URL=<YOUR_REDMINE_URL>
REDMINE_PAT=<YOUR_REDMINE_API_KEY>
REDMINE_MCP_PATH=<PATH_TO_REDMINE_MCP_SERVER>

# ─── MongoDB (read-only) ────────────────────────────────────────────────
MONGO_READ_URI=<READONLY_MONGODB_CONNECTION_STRING>

# ─── PostgreSQL (read-only) ─────────────────────────────────────────────
POSTGRES_READ_URI=<READONLY_POSTGRES_CONNECTION_STRING>
