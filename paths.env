# Enterprise AI Platform — local path configuration
# Edit this after pulling the repo. No secrets here — plain folder paths only
# (unlike .env, this file is tracked by git and safe to commit).
#
# Leave any value blank to keep that item's existing default behavior — see
# the comment above each key. Blank is a valid, supported choice, not an
# error.

# ─── Plan output path ──────────────────────────────────────────────────────
# Where /planning and /plan-reviewer write PLAN.md and TEST-CASES.xlsx (and
# where /plan-reviewer's revised versions go on a not-approved pass).
# Leave blank to keep the existing default: the current working directory.
PLAN_OUTPUT_PATH=

# ─── Knowledge output path ─────────────────────────────────────────────────
# Where /knowledge-capture writes new or extended knowledge files.
# Leave blank to keep the existing default: shared/knowledge/ inside this repo.
KNOWLEDGE_OUTPUT_PATH=

# ─── Usage log path ─────────────────────────────────────────────────────────
# Where the usage-logger.js hook (UserPromptSubmit, system-wide) writes the
# daily prompt/session log that /usage-report reads.
# Leave blank to keep the existing default: ~/.claude/usage-logs/
# NOTE: the hook runs globally (any repo, any folder), so it reads this value
# from ~/.claude/paths.env (a mirrored copy of this same file), not from here
# directly — keep the two in sync if you change this value. /usage-report and
# the install tooling will do that sync for you; a manual edit here needs a
# manual copy to ~/.claude/paths.env to actually take effect for the hook.
USAGE_LOG_PATH=

# ─── AI context input folder ───────────────────────────────────────────────
# Where you store your logs, specs, and design files for the `context`
# argument shorthand (see context/README.md for how it's used in a prompt).
# This folder should live OUTSIDE the repository so git never tracks your
# content — only this path pointer is tracked, not the folder itself.
# Checked FIRST. Leave blank to fall back to context/context.path (the
# original mechanism, unchanged, still there for anyone already using it) —
# and if that's also blank, falls back further to context/ inside this repo.
CONTEXT_PATH=

# ─── Machine bootstrap: sibling tool repos ─────────────────────────────────
# Where install/bootstrap.sh looks for (and clones, if missing)
# knowledge-graph-generator and code-cortex-mcp — the two repos Unified
# Trace merges. Leave blank to use the default: the directory that
# directly contains this enterprise-ai-platform checkout (i.e. these three
# repos are siblings on disk). Only set this if you deliberately keep them
# somewhere else.
TOOLS_DIR=

# ─── Machine bootstrap: your product repos ─────────────────────────────────
# Where your own backend/frontend project repos live, so bootstrap can warn
# (never block) if Knowledge Generator's indexing targets aren't found yet.
# Leave blank to use the default: one directory above TOOLS_DIR. Purely
# informational — indexing itself stays config-driven via
# knowledge-graph-generator/kg-config.env, never triggered by bootstrap.
PROJECTS_DIR=

# ─── Cross-platform runtime overrides (all optional; blank = auto-detect) ───
# Machine-specific values belong in paths.local.env (gitignored), NOT here.
# Precedence: environment > paths.local.env > paths.env.
# KNOWLEDGE_GRAPH_PATH= knowledge-graph-generator dir (default: shared/mcp-tools/knowledge-graph-generator)
# CODE_CORTEX_PATH=     code-cortex-mcp executable (default: per-OS install location / PATH)
# PYTHON_PATH=          BASE python used to create .venv-mcp (default: python3 / python on PATH)
# NODE_PATH=            node executable (default: the node running the platform)
#                       NOTE: read from these files or EAP_NODE_PATH only — never from the
#                       process NODE_PATH, which Node uses as a module search path.
KNOWLEDGE_GRAPH_PATH=
CODE_CORTEX_PATH=
PYTHON_PATH=
NODE_PATH=
