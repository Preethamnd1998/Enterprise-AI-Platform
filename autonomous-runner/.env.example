# Copy to .env (gitignored) and fill in real values. Never commit this file with real secrets.

# Required: Anthropic API key used by the Claude Agent SDK.
# Alternative to a bare API key: run `ant auth login` once and leave this unset — the SDK
# picks up the active CLI profile automatically.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides — CLI flags (--model, --fallback-model) take precedence over these.
AI_RUNNER_MODEL=claude-opus-5
AI_RUNNER_FALLBACK_MODEL=claude-sonnet-5

# Optional: point the runner at an enterprise-ai-platform checkout other than the one this
# package ships inside (rarely needed — autonomous-runner auto-detects its own platform root).
# AI_RUNNER_PLATFORM_ROOT=/path/to/enterprise-ai-platform

# Only needed if the target repository's .mcp.json references these (shared/mcp/.mcp.json.template
# convention: ${env:VAR} substitution). All servers reused this way must be read-only —
# see shared/mcp/tool-allowlists.md.
# GITLAB_MCP_PATH=
# GITLAB_BASE_URL=
# GITLAB_PAT=
# REDMINE_MCP_PATH=
# REDMINE_URL=
# REDMINE_PAT=
# MONGO_READ_URI=
# POSTGRES_READ_URI=
